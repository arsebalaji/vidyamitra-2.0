  "components": {
    "schemas": {
      "Body_photo_api_v1_tutor_photo_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "consent": {
            "type": "boolean",
            "title": "Consent",
            "default": false
          },
          "language": {
            "type": "string",
            "enum": [
              "te",
              "en"
            ],
            "title": "Language",
            "default": "te"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_photo_api_v1_tutor_photo_post"
      },
      "CheckRequest": {
        "properties": {
          "question_id": {
            "type": "string",
            "maxLength": 60,
            "title": "Question Id"
          },
          "answer": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "pattern": "^\\s*[+-]?\\d{1,9}(?:\\s*/\\s*[+-]?\\d{1,9})?\\s*$",
            "title": "Answer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question_id",
          "answer"
        ],
        "title": "CheckRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "TutorRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 1500,
            "title": "Message",
            "default": ""
          },
          "lesson_id": {
            "type": "string",
            "maxLength": 50,
            "title": "Lesson Id"
          },
          "language": {
            "type": "string",
            "enum": [
              "te",
              "en"
            ],
            "title": "Language",
            "default": "te"
          },
          "mode": {
            "type": "string",
            "enum": [
              "simple",
              "steps",
              "example",
              "hint"
            ],
            "title": "Mode",
            "default": "steps"
          },
          "online": {
            "type": "boolean",
            "title": "Online",
            "default": false
          },
          "consent": {
            "type": "boolean",
            "title": "Consent",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "lesson_id"
        ],
        "title": "TutorRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
